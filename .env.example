# Copie este arquivo para um novo arquivo chamado ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# String de conexão do banco PostgreSQL (Supabase)
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Chave da Google Places API (New)
GOOGLE_MAPS_API_KEY=

# Chave da API de clima (se usada no projeto)
WEATHER_API_KEY=
